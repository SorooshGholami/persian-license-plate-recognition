# automatically by lpr/config.py. Every value here is optional.

# --- Camera -----------------------------------------------------------------
# An RTSP URL, a path to a video file, or a webcam index such as 0.
LPR_CAMERA_SOURCE=rtsp://USERNAME:PASSWORD@IP:PORT/1/1
LPR_CAMERA_RECONNECT_DELAY=2.0

# --- Detection --------------------------------------------------------------
LPR_DETECTION_CHECKPOINT=ckpt-52
LPR_DETECTION_THRESHOLD=0.7
LPR_VISUALIZATION_THRESHOLD=0.8

# --- Character segmentation -------------------------------------------------
# Blobs smaller than area/MIN or larger than area/MAX are not characters.
# Retune these if plates from a new camera segment poorly.
LPR_PLATE_RESIZE_WIDTH=400
LPR_SEGMENT_MIN_AREA_DIVISOR=130
LPR_SEGMENT_MAX_AREA_DIVISOR=30

# --- Database (optional; results are always written to outputs/) ------------
LPR_DB_ENABLED=false
LPR_DB_HOST=?
LPR_DB_PORT=?
LPR_DB_USER=?
LPR_DB_PASSWORD=?
LPR_DB_NAME=?

# --- Web dashboard ----------------------------------------------------------
LPR_WEB_HOST=127.0.0.1
LPR_WEB_PORT=?
LPR_WEB_SECRET_KEY=change-me-to-a-random-string
LPR_WEB_PLATE_LIMIT=20
